{
    "name":  "datebloom",
    "private":  true,
    "packageManager":  "pnpm@10.12.4",
    "scripts":  {
                    "dev":  "pnpm --filter @datebloom/web dev",
                    "lint":  "pnpm --filter @datebloom/web lint",
                    "typecheck":  "pnpm --filter @datebloom/web typecheck",
                    "test":  "pnpm --filter @datebloom/web test",
                    "test:browser":  "pnpm --filter @datebloom/web test:browser",
                    "restaurants:refresh": "pnpm --filter @datebloom/web restaurants:refresh",
                    "restaurants:review": "pnpm --filter @datebloom/web restaurants:review",
                    "hooks": "git config core.hooksPath .githooks"
                },
    "engines":  {
                    "node":  "\u003e=24.15.0"
                }
}
